# Normalise to LF in the repository.
* text=auto eol=lf

# Shell scripts MUST keep LF -- CRLF breaks the shebang on Linux/macOS, which
# is exactly where install.sh runs.
*.sh text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1 text eol=crlf

# Never touch binaries.
*.whl binary
*.png binary
*.gz  binary

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noa Katz <noa@devstack.local>
Date: Tue, 15 Sep 2026 11:00:00 +0300
Subject: [PATCH 07/10] TEAM-4 Get, update and delete a todo

---
 internal/todo/handler.go      | 73 +++++++++++++++++++++++++++++++++++
 internal/todo/handler_test.go | 51 ++++++++++++++++++++++++
 internal/todo/store.go        | 26 +++++++++++++
 3 files changed, 150 insertions(+)

diff --git a/internal/todo/handler.go b/internal/todo/handler.go
index b50dba2..d8d5e9b 100644
--- a/internal/todo/handler.go
+++ b/internal/todo/handler.go
@@ -1,7 +1,10 @@
 package todo
 
 import (
+	"errors"
 	"net/http"
+	"strconv"
+	"strings"
 )
 
 // Handler serves the todo API over a Store.
@@ -18,6 +21,9 @@ func NewHandler(store *Store) *Handler {
 func (h *Handler) Register(mux *http.ServeMux) {
 	mux.HandleFunc("GET /todos", h.list)
 	mux.HandleFunc("POST /todos", h.create)
+	mux.HandleFunc("GET /todos/{id}", h.get)
+	mux.HandleFunc("PATCH /todos/{id}", h.update)
+	mux.HandleFunc("DELETE /todos/{id}", h.delete)
 }
 
 func (h *Handler) list(w http.ResponseWriter, r *http.Request) {
@@ -40,3 +46,70 @@ func (h *Handler) create(w http.ResponseWriter, r *http.Request) {
 	}
 	writeJSON(w, http.StatusCreated, h.store.Create(title))
 }
+
+func (h *Handler) get(w http.ResponseWriter, r *http.Request) {
+	id, ok := pathID(w, r)
+	if !ok {
+		return
+	}
+	t, err := h.store.Get(id)
+	if err != nil {
+		h.storeError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusOK, t)
+}
+
+type updateRequest struct {
+	Title string `json:"title"`
+}
+
+func (h *Handler) update(w http.ResponseWriter, r *http.Request) {
+	id, ok := pathID(w, r)
+	if !ok {
+		return
+	}
+	var req updateRequest
+	if !decode(w, r, &req) {
+		return
+	}
+	t, err := h.store.Update(id, func(t *Todo) {
+		t.Title = strings.TrimSpace(req.Title)
+	})
+	if err != nil {
+		h.storeError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusOK, t)
+}
+
+func (h *Handler) delete(w http.ResponseWriter, r *http.Request) {
+	id, ok := pathID(w, r)
+	if !ok {
+		return
+	}
+	if err := h.store.Delete(id); err != nil {
+		h.storeError(w, err)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// pathID reads the {id} path segment. On failure it writes a 400 and
+// returns false.
+func pathID(w http.ResponseWriter, r *http.Request) (int, bool) {
+	id, err := strconv.Atoi(r.PathValue("id"))
+	if err != nil || id < 1 {
+		writeError(w, http.StatusBadRequest, "id must be a positive integer")
+		return 0, false
+	}
+	return id, true
+}
+
+func (h *Handler) storeError(w http.ResponseWriter, err error) {
+	if errors.Is(err, ErrNotFound) {
+		writeError(w, http.StatusNotFound, err.Error())
+		return
+	}
+	writeError(w, http.StatusInternalServerError, "internal error")
+}
diff --git a/internal/todo/handler_test.go b/internal/todo/handler_test.go
index 6f4fc31..55ce69a 100644
--- a/internal/todo/handler_test.go
+++ b/internal/todo/handler_test.go
@@ -89,3 +89,54 @@ func TestHandlerListEmptyIsAnArray(t *testing.T) {
 		t.Errorf("body = %s; want []", body)
 	}
 }
+
+func TestHandlerGet(t *testing.T) {
+	store := NewStore()
+	store.Create("buy milk")
+	h := NewHandler(store)
+
+	if rec := serve(t, h, "GET", "/todos/1", ""); rec.Code != http.StatusOK {
+		t.Errorf("GET /todos/1 status = %d; want 200", rec.Code)
+	}
+	if rec := serve(t, h, "GET", "/todos/2", ""); rec.Code != http.StatusNotFound {
+		t.Errorf("GET /todos/2 status = %d; want 404", rec.Code)
+	}
+	if rec := serve(t, h, "GET", "/todos/abc", ""); rec.Code != http.StatusBadRequest {
+		t.Errorf("GET /todos/abc status = %d; want 400", rec.Code)
+	}
+}
+
+func TestHandlerUpdateTitle(t *testing.T) {
+	store := NewStore()
+	store.Create("buy milk")
+	h := NewHandler(store)
+
+	rec := serve(t, h, "PATCH", "/todos/1", `{"title": "buy oat milk"}`)
+
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d; want 200. body: %s", rec.Code, rec.Body)
+	}
+	if got := decodeBody[Todo](t, rec); got.Title != "buy oat milk" {
+		t.Errorf("title = %q; want %q", got.Title, "buy oat milk")
+	}
+}
+
+func TestHandlerUpdateMissing(t *testing.T) {
+	rec := serve(t, NewHandler(NewStore()), "PATCH", "/todos/1", `{"title": "x"}`)
+	if rec.Code != http.StatusNotFound {
+		t.Errorf("status = %d; want 404", rec.Code)
+	}
+}
+
+func TestHandlerDelete(t *testing.T) {
+	store := NewStore()
+	store.Create("buy milk")
+	h := NewHandler(store)
+
+	if rec := serve(t, h, "DELETE", "/todos/1", ""); rec.Code != http.StatusNoContent {
+		t.Fatalf("status = %d; want 204", rec.Code)
+	}
+	if rec := serve(t, h, "DELETE", "/todos/1", ""); rec.Code != http.StatusNotFound {
+		t.Errorf("second delete status = %d; want 404", rec.Code)
+	}
+}
diff --git a/internal/todo/store.go b/internal/todo/store.go
index e50ee13..c1a94d0 100644
--- a/internal/todo/store.go
+++ b/internal/todo/store.go
@@ -58,3 +58,29 @@ func (s *Store) Get(id int) (Todo, error) {
 	}
 	return *t, nil
 }
+
+// Update applies fn to the todo with the given id and returns the result.
+func (s *Store) Update(id int, fn func(*Todo)) (Todo, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	t, ok := s.todos[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	fn(t)
+	t.UpdatedAt = s.now()
+	return *t, nil
+}
+
+// Delete removes the todo with the given id.
+func (s *Store) Delete(id int) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if _, ok := s.todos[id]; !ok {
+		return ErrNotFound
+	}
+	delete(s.todos, id)
+	return nil
+}

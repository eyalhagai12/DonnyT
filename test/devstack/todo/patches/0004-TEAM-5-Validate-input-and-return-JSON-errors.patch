diff --git a/internal/todo/respond.go b/internal/todo/respond.go
new file mode 100644
index 0000000..2bb65e8
--- /dev/null
+++ b/internal/todo/respond.go
@@ -0,0 +1,60 @@
+package todo
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"unicode/utf8"
+)
+
+// maxTitle is the longest title accepted, in characters.
+const maxTitle = 200
+
+// maxBody caps request bodies; a todo is a few hundred bytes at most.
+const maxBody = 1 << 16
+
+// errorBody is what every failed request returns.
+type errorBody struct {
+	Error string `json:"error"`
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	json.NewEncoder(w).Encode(v)
+}
+
+func writeError(w http.ResponseWriter, status int, msg string) {
+	writeJSON(w, status, errorBody{Error: msg})
+}
+
+// decode reads a JSON body into v. On failure it writes a 400 and returns
+// false, so a handler can simply return.
+func decode(w http.ResponseWriter, r *http.Request, v any) bool {
+	dec := json.NewDecoder(http.MaxBytesReader(w, r.Body, maxBody))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(v); err != nil {
+		var tooBig *http.MaxBytesError
+		if errors.As(err, &tooBig) {
+			writeError(w, http.StatusRequestEntityTooLarge, "request body too large")
+		} else {
+			writeError(w, http.StatusBadRequest, "invalid JSON: "+err.Error())
+		}
+		return false
+	}
+	return true
+}
+
+// validTitle trims a title and checks it is present and not too long.
+func validTitle(title string) (string, error) {
+	title = strings.TrimSpace(title)
+	if title == "" {
+		return "", errors.New("title is required")
+	}
+	if n := utf8.RuneCountInString(title); n > maxTitle {
+		return "", fmt.Errorf("title is %d characters; the limit is %d", n, maxTitle)
+	}
+	return title, nil
+}
diff --git a/internal/todo/respond_test.go b/internal/todo/respond_test.go
new file mode 100644
index 0000000..0db9e19
--- /dev/null
+++ b/internal/todo/respond_test.go
@@ -0,0 +1,34 @@
+package todo
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestValidTitle(t *testing.T) {
+	tests := []struct {
+		name    string
+		in      string
+		want    string
+		wantErr bool
+	}{
+		{"plain", "buy milk", "buy milk", false},
+		{"trimmed", "  buy milk \n", "buy milk", false},
+		{"empty", "", "", true},
+		{"only spaces", "   ", "", true},
+		{"at the limit", strings.Repeat("a", maxTitle), strings.Repeat("a", maxTitle), false},
+		{"over the limit", strings.Repeat("a", maxTitle+1), "", true},
+		{"counts characters, not bytes", strings.Repeat("ש", maxTitle), strings.Repeat("ש", maxTitle), false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := validTitle(tt.in)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("err = %v; wantErr %v", err, tt.wantErr)
+			}
+			if got != tt.want {
+				t.Errorf("got %q; want %q", got, tt.want)
+			}
+		})
+	}
+}

diff --git a/client/client.go b/client/client.go
index 67b8c84..376e1a4 100644
--- a/client/client.go
+++ b/client/client.go
@@ -43,6 +43,25 @@ func (c *Client) Add(title string) (Todo, error) {
 	return t, c.do("POST", "/todos", map[string]string{"title": title}, &t)
 }
 
+// SetDone marks a todo done or not done. The title is sent too: the API's
+// PATCH replaces it.
+func (c *Client) SetDone(id int, title string, done bool) (Todo, error) {
+	var t Todo
+	body := map[string]any{"title": title, "done": done}
+	return t, c.do("PATCH", fmt.Sprintf("/todos/%d", id), body, &t)
+}
+
+// Get returns one todo.
+func (c *Client) Get(id int) (Todo, error) {
+	var t Todo
+	return t, c.do("GET", fmt.Sprintf("/todos/%d", id), nil, &t)
+}
+
+// Delete removes a todo.
+func (c *Client) Delete(id int) error {
+	return c.do("DELETE", fmt.Sprintf("/todos/%d", id), nil, nil)
+}
+
 // do sends one request and decodes the JSON response into out. The API's
 // {"error": "..."} body becomes the returned error.
 func (c *Client) do(method, path string, body, out any) error {
diff --git a/client/client_test.go b/client/client_test.go
index 5f02673..f2acade 100644
--- a/client/client_test.go
+++ b/client/client_test.go
@@ -61,3 +61,37 @@ func TestAPIErrorIsReturned(t *testing.T) {
 		t.Errorf("err = %v; want the API's message", err)
 	}
 }
+
+func TestSetDoneAndDelete(t *testing.T) {
+	todos := map[string]Todo{"1": {ID: 1, Title: "buy milk"}}
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /todos/{id}", func(w http.ResponseWriter, r *http.Request) {
+		json.NewEncoder(w).Encode(todos[r.PathValue("id")])
+	})
+	mux.HandleFunc("PATCH /todos/{id}", func(w http.ResponseWriter, r *http.Request) {
+		var req Todo
+		json.NewDecoder(r.Body).Decode(&req)
+		t := todos[r.PathValue("id")]
+		t.Title, t.Done = req.Title, req.Done
+		todos[r.PathValue("id")] = t
+		json.NewEncoder(w).Encode(t)
+	})
+	mux.HandleFunc("DELETE /todos/{id}", func(w http.ResponseWriter, r *http.Request) {
+		delete(todos, r.PathValue("id"))
+		w.WriteHeader(http.StatusNoContent)
+	})
+	srv := httptest.NewServer(mux)
+	defer srv.Close()
+	c := New(srv.URL)
+
+	got, err := c.SetDone(1, "buy milk", true)
+	if err != nil || !got.Done || got.Title != "buy milk" {
+		t.Fatalf("SetDone = %+v, %v", got, err)
+	}
+	if err := c.Delete(1); err != nil {
+		t.Fatal(err)
+	}
+	if len(todos) != 0 {
+		t.Errorf("todo still there after Delete: %+v", todos)
+	}
+}

+// idArg reads the todo id after a command: todo-cli done 3.
+func idArg(args []string) (int, error) {
+	if len(args) != 2 {
+		return 0, fmt.Errorf("usage: todo-cli %s ID", args[0])
+	}
+	id, err := strconv.Atoi(args[1])
+	if err != nil || id < 1 {
+		return 0, fmt.Errorf("%q is not a todo id", args[1])
+	}
+	return id, nil
+}

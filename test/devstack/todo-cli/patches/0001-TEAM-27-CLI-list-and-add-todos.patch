@@ -0,0 +1,63 @@
+package client
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+// fakeAPI serves a tiny in-memory version of the todo API.
+func fakeAPI(t *testing.T) *httptest.Server {
+	t.Helper()
+	todos := []Todo{}
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /todos", func(w http.ResponseWriter, r *http.Request) {
+		json.NewEncoder(w).Encode(todos)
+	})
+	mux.HandleFunc("POST /todos", func(w http.ResponseWriter, r *http.Request) {
+		var req struct {
+			Title string `json:"title"`
+		}
+		json.NewDecoder(r.Body).Decode(&req)
+		if req.Title == "" {
+			w.WriteHeader(http.StatusBadRequest)
+			json.NewEncoder(w).Encode(map[string]string{"error": "title is required"})
+			return
+		}
+		todo := Todo{ID: len(todos) + 1, Title: req.Title}
+		todos = append(todos, todo)
+		w.WriteHeader(http.StatusCreated)
+		json.NewEncoder(w).Encode(todo)
+	})
+	srv := httptest.NewServer(mux)
+	t.Cleanup(srv.Close)
+	return srv
+}
+
+func TestAddThenList(t *testing.T) {
+	c := New(fakeAPI(t).URL)
+
+	added, err := c.Add("buy milk")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if added.ID != 1 || added.Title != "buy milk" {
+		t.Errorf("added %+v", added)
+	}
+
+	todos, err := c.List()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(todos) != 1 || todos[0].Title != "buy milk" {
+		t.Errorf("list = %+v", todos)
+	}
+}
+
+func TestAPIErrorIsReturned(t *testing.T) {
+	_, err := New(fakeAPI(t).URL).Add("")
+	if err == nil || err.Error() != "POST /todos: title is required" {
+		t.Errorf("err = %v; want the API's message", err)
+	}
+}

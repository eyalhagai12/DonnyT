+// Command todo-cli is a command-line client for the todo API.
+//
+//	todo-cli list
+//	todo-cli add buy milk
+//
+// TODO_URL points it at the API (default http://localhost:8081).
+package main
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"example.local/todo-cli/client"
+)
+
+func main() {
+	if err := run(os.Args[1:]); err != nil {
+		fmt.Fprintln(os.Stderr, "todo-cli:", err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string) error {
+	if len(args) == 0 {
+		return fmt.Errorf("usage: todo-cli list | add TITLE")
+	}
+	c := client.New(env("TODO_URL", "http://localhost:8081"))
+
+	switch args[0] {
+	case "list":
+		todos, err := c.List()
+		if err != nil {
+			return err
+		}
+		for _, t := range todos {
+			fmt.Println(line(t))
+		}
+		return nil
+	case "add":
+		title := strings.Join(args[1:], " ")
+		t, err := c.Add(title)
+		if err != nil {
+			return err
+		}
+		fmt.Println(line(t))
+		return nil
+	}
+	return fmt.Errorf("unknown command %q", args[0])
+}
+
+// line renders a todo as "[x]  3  buy milk".
+func line(t client.Todo) string {
+	box := "[ ]"
+	if t.Done {
+		box = "[x]"
+	}
+	return fmt.Sprintf("%s %3d  %s", box, t.ID, t.Title)
+}
+
+func env(key, fallback string) string {
+	if v := os.Getenv(key); v != "" {
+		return v
+	}
+	return fallback
+}

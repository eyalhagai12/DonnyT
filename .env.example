# ===========================================================================
# DonnyT credentials.  Copy to .env and fill in.  NEVER commit .env.
#
#   cp .env.example .env                 (macOS/Linux)
#   Copy-Item .env.example .env          (Windows PowerShell)
#
# See INSTALL.md step 4 for how to mint each token.
# ===========================================================================

# --- Atlassian (Confluence + Jira share one token) -------------------------
# The email you sign in to Atlassian with.
ATLASSIAN_EMAIL=

# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
# "Create API token" -> copy immediately, it is shown once.
ATLASSIAN_API_TOKEN=


# --- GitLab ----------------------------------------------------------------
# Personal access token. Required scopes: api, read_repository
# Create at: <your-gitlab-url>/-/user_settings/personal_access_tokens
GITLAB_TOKEN=


# ===========================================================================
# Internal / isolated network settings.  Uncomment only if your network
# needs them.  Symptoms and fixes are in INSTALL.md "Troubleshooting".
# ===========================================================================

# TLS interception: if requests fail with CERTIFICATE_VERIFY_FAILED, point
# this at your organisation's root CA certificate (PEM format).
# DONNYT_CA_BUNDLE=C:\certs\corporate-root-ca.pem

# Outbound proxy, if your host reaches Jira/GitLab through one.
# HTTPS_PROXY=http://proxy.internal.corp:8080
# HTTP_PROXY=http://proxy.internal.corp:8080
# NO_PROXY=localhost,127.0.0.1,.internal.corp

# Last resort only: skip TLS verification entirely. Prefer DONNYT_CA_BUNDLE.
# DONNYT_INSECURE_TLS=false
